FROM node:22.18.0-bookworm-slim AS builder

WORKDIR /src/webui

COPY webui/package.json webui/package-lock.json ./

RUN npm ci

COPY webui/ ./

RUN npm run build-prod

FROM nginxinc/nginx-unprivileged:1.27.3-alpine

COPY --from=builder /src/webui/dist /usr/share/nginx/html
COPY webui/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
